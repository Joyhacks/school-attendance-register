{
  "name": "attendance-system",
  "version": "1.0.0",
  "description": "School attendance management system. HTML, CSS and JavaScript on the front, Node.js, Express and MySQL on the back.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed:demo": "node scripts/seed-demo.js",
    "test": "node --test tests/unit/attendanceMath.test.js tests/unit/validators.test.js tests/unit/csv.test.js",
    "test:api": "node --test --test-concurrency=1 tests/api/api.test.js tests/api/setup.test.js"
  },
  "license": "MIT",
  "author": "Adeola Ilori",
  "repository": "github:Joyhacks/school-attendance-register",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6"
  }
}
