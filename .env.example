# Copy this file to .env, or run "npm run setup" and it writes .env for you.

# MySQL connection. XAMPP defaults: user root, empty password.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=attendance_system

# Port the website runs on. Open http://localhost:3000
PORT=3000

# Shown on the login page and in the header.
SCHOOL_NAME=My School
# Optional. Shown under the school name on the sign-in page.
SCHOOL_MOTTO=
# Optional. A short line on every page, for example
# "Student project. Not an official school system."
PROJECT_NOTE=

# Long random text that signs login cookies. Setup generates one.
SESSION_SECRET=

# Set to production when the site runs on a real server with HTTPS.
NODE_ENV=development
